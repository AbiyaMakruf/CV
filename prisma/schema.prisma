generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MasterProfile {
  id             String   @id @default("default")
  personalInfo   String   // JSON: PersonalInfo
  experiences    String   // JSON: WorkExperience[]
  education      String   // JSON: EducationItem[]
  certifications String   // JSON: CertificationItem[]
  projects       String   // JSON: ProjectItem[]
  skills         String   // JSON: SkillCategory[]
  publications   String   // JSON: PublicationItem[]
  awards         String   // JSON: AwardItem[]
  volunteer      String   // JSON: VolunteerItem[]
  updatedAt      DateTime @updatedAt
}

model TailoredResume {
  id               String           @id @default(cuid())
  title            String           // e.g., "Frontend Engineer - Tokopedia"
  collection       String           @default("General") // e.g., "Frontend Engineer", "ML Researcher", "Tech Lead"
  targetRole       String           @default("")
  targetCompany    String           @default("")
  jobUrl           String           @default("")
  jobDescription   String           @default("")
  templateId       String           @default("harvard") // "harvard" | "modern" | "tech"
  fontFamily       String           @default("Calibri") // "Calibri" | "Arial" | "Helvetica" | "Garamond" | "Times New Roman"
  fontSize         String           @default("medium")  // "small" | "medium" | "large"
  pageLimit        Int              @default(1)         // 1 or 2 pages
  cvData           String           // JSON: ResumeDocumentData (snapshot of tailored profile)
  atsAnalysis      String           @default("{}")      // JSON: AtsAnalysisResult
  coverLetter      String           @default("")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  applications     JobApplication[]
}

model JobApplication {
  id               String          @id @default(cuid())
  companyName      String
  roleTitle        String
  jobUrl           String          @default("")
  location         String          @default("")
  status           String          @default("APPLIED") // "WISHLIST" | "APPLIED" | "INTERVIEW" | "OFFER" | "REJECTED"
  appliedDate      String          @default("")
  salaryRange      String          @default("")
  notes            String          @default("")
  tailoredResumeId String?
  tailoredResume   TailoredResume? @relation(fields: [tailoredResumeId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
